<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.MisioFlix</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.MisioFlix</AssemblyName>
    <Version>0.4.19</Version>
    <AssemblyVersion>0.4.19.0</AssemblyVersion>
    <FileVersion>0.4.19.0</FileVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Jellyfin 12.4 hosts these assemblies. Do NOT ship additional copies. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Common" Version="12.4.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.4.0" ExcludeAssets="runtime" />
    <EmbeddedResource Include="Web/**/*" />
  </ItemGroup>
</Project>
